{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.1.0",
  "description": "__MSG_extensionDescription__",
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "js": [
        "extension/settings-bridge.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "js": [
        "scripts/catch-up.js",
        "extension/content.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "permissions": [
    "storage"
  ],
  "options_ui": {
    "page": "extension/options.html",
    "open_in_tab": true
  },
  "default_locale": "en",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "homepage_url": "https://github.com/kyoh86/twitch-latency-mitigator"
}
